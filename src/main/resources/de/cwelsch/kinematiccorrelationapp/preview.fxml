<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<?import javafx.scene.layout.StackPane?>
<VBox xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="1290.0" minHeight="-Infinity"
      minWidth="1280.0" prefWidth="1920.0" spacing="20.0" xmlns="http://javafx.com/javafx/21">
    <children>
        <Label text="Preview">
            <font>
                <Font name="System Bold" size="26.0"/>
            </font>
        </Label>
        <StackPane fx:id="threeDContainer" VBox.vgrow="ALWAYS" prefHeight="600.0"
                   style="-fx-background-color: #1a1a1a; -fx-background-radius: 8;"/>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</VBox>
